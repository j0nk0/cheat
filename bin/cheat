#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

for candidate in \
	"$SCRIPT_DIR/../lib/cheat.sh" \
	"$SCRIPT_DIR/../lib/cheat/cheat.sh" \
	"$SCRIPT_DIR/cheat.sh"; do
	if [[ -f "$candidate" ]]; then
		exec "$candidate" "$@"
	fi
done

printf 'cheat: implementation not found\n' >&2
exit 1